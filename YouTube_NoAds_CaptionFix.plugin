#!name=YouTube 去广告字幕修复版
#!desc=保留 YouTube 信息流去广告，跳过 player/get_watch 字幕核心响应，修复 iPhone YouTube 自动翻译字幕 error loading captions。
#!author=Modified for Loon
#!openUrl=https://github.com/ReiAKIraAn/surge-rules
#!homepage=https://github.com/ReiAKIraAn/surge-rules
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

[MITM]
hostname=*.googlevideo.com, youtubei.googleapis.com

[Rule]
AND,((DOMAIN-SUFFIX, googlevideo.com), (PROTOCOL, QUIC)),REJECT
AND,((DOMAIN-SUFFIX, youtubei.googleapis.com), (PROTOCOL, QUIC)),REJECT

[Rewrite]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad reject-200

[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|search|reel\/reel_watch_sequence|guide|account\/get_setting))(\?(.*))?$ script-path=https://raw.githubusercontent.com/ReiAKIraAn/surge-rules/main/YouTube_remove_ads_captions_fixed.js, requires-body=true, binary-body-mode=true, timeout=20, tag=YouTube去广告字幕修复版
